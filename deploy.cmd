@echo off
chcp 65001 > nul
title اسکریپت نصب خودکار پنل دیزاینو روی کلودفلر (Windows)
echo =======================================================
echo 🚀 به اسکریپت نصب خودکار «دیزاینو وی پی ان» روی کلودفلر خوش آمدید
echo =======================================================
echo.

echo 1. بررسی و ورود به حساب کلودفلر...
call npx wrangler login

echo.
echo 2. در حال ساخت KV Namespace ماندگار در کلودفلر...
call npx wrangler kv:namespace create DIZYNO_KV

echo.
echo 3. در حال دپلوی و انتشار ورکر روی کلودفلر...
call npx wrangler deploy

echo.
echo =======================================================
echo 🎉 نصب با موفقیت انجام شد!
echo آدرس ورکر شما در کلودفلر آماده استفاده است.
echo =======================================================
pause
